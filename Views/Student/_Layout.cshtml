@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - StudyGPT
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Main CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Student Sidebar CSS -->
    <link rel="stylesheet"
          href="~/css/student.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>

<body class="student-body">

    <div class="student-layout">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <aside class="student-sidebar">

            <!-- LOGO -->

            <div class="student-logo">

                <a asp-controller="Student"
                   asp-action="Dashboard">

                    <div class="student-logo-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>

                    <div class="student-logo-text">

                        <span class="student-logo-name">
                            StudyGPT
                        </span>

                        <span class="student-logo-role">
                            STUDENT PORTAL
                        </span>

                    </div>

                </a>

            </div>


            <!-- NAVIGATION -->

            <nav class="student-navigation">

                <div class="student-nav-section">
                    MAIN
                </div>


                <!-- DASHBOARD -->

                <a asp-controller="Student"
                   asp-action="Dashboard"
                   class="student-nav-link @(currentAction == "Dashboard" ? "active" : "")">

                    <span class="student-nav-icon">
                        <i class="bi bi-grid-1x2-fill"></i>
                    </span>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- SUBJECTS -->

                <a asp-controller="Student"
                   asp-action="Subjects"
                   class="student-nav-link @(currentAction == "Subjects" ? "active" : "")">

                    <span class="student-nav-icon">
                        <i class="bi bi-book-fill"></i>
                    </span>

                    <span>
                        Subjects
                    </span>

                </a>


                <!-- AI ASSISTANT -->

                <a asp-controller="Student"
                   asp-action="AIAssistant"
                   class="student-nav-link @(currentAction == "AIAssistant" ? "active" : "")">

                    <span class="student-nav-icon">
                        <i class="bi bi-robot"></i>
                    </span>

                    <span>
                        AI Assistant
                    </span>

                    <span class="student-ai-badge">
                        AI
                    </span>

                </a>


                <div class="student-nav-section student-nav-section-spaced">
                    ACCOUNT
                </div>


                <!-- PROFILE -->

                <a asp-controller="Student"
                   asp-action="Profile"
                   class="student-nav-link @(currentAction == "Profile" ? "active" : "")">

                    <span class="student-nav-icon">
                        <i class="bi bi-person-circle"></i>
                    </span>

                    <span>
                        My Profile
                    </span>

                </a>


                <!-- LOGOUT -->

                <a asp-controller="Auth"
                   asp-action="Logout"
                   class="student-nav-link student-logout-link">

                    <span class="student-nav-icon">
                        <i class="bi bi-box-arrow-right"></i>
                    </span>

                    <span>
                        Logout
                    </span>

                </a>

            </nav>


            <!-- SIDEBAR BOTTOM -->

            <div class="student-sidebar-bottom">

                <div class="student-user-card">

                    <div class="student-user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div class="student-user-info">

                        <strong>
                            Student
                        </strong>

                        <small>
                            StudyGPT
                        </small>

                    </div>

                </div>

            </div>

        </aside>


        <!-- ================================================= -->
        <!-- MAIN -->
        <!-- ================================================= -->

        <div class="student-main">

            <!-- TOPBAR -->

            <header class="student-topbar">

                <div class="student-topbar-left">

                    <button type="button"
                            class="student-mobile-menu"
                            id="studentMobileMenu">

                        <i class="bi bi-list"></i>

                    </button>

                    <div>

                        <span class="student-top-label">
                            STUDENT PORTAL
                        </span>

                        <h5>
                            @ViewData["Title"]
                        </h5>

                    </div>

                </div>


                <!-- TOP RIGHT -->

                <div class="student-topbar-right">

                    <div class="student-status">

                        <span class="student-status-dot"></span>

                        Online

                    </div>


                    <a asp-controller="Student"
                       asp-action="Profile"
                       class="student-profile-button">

                        <i class="bi bi-person-circle"></i>

                        <span>
                            Student
                        </span>

                    </a>

                </div>

            </header>


            <!-- ================================================= -->
            <!-- PAGE CONTENT -->
            <!-- ================================================= -->

            <main class="student-content">

                @RenderBody()

            </main>


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <footer class="student-footer">

                <span>
                    © @DateTime.Now.Year StudyGPT
                </span>

                <span>
                    Student Portal
                </span>

            </footer>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- MOBILE OVERLAY -->
    <!-- ================================================= -->

    <div class="student-sidebar-overlay"
         id="studentSidebarOverlay">
    </div>


    <!-- ================================================= -->
    <!-- JAVASCRIPT -->
    <!-- ================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const menuButton =
                document.getElementById("studentMobileMenu");

            const sidebar =
                document.querySelector(".student-sidebar");

            const overlay =
                document.getElementById("studentSidebarOverlay");


            /*
             * OPEN / CLOSE MOBILE SIDEBAR
             */

            if (menuButton && sidebar && overlay) {

                menuButton.addEventListener("click", function () {

                    sidebar.classList.toggle("mobile-open");

                    overlay.classList.toggle("show");

                });


                overlay.addEventListener("click", function () {

                    sidebar.classList.remove("mobile-open");

                    overlay.classList.remove("show");

                });

            }


            /*
             * CLOSE SIDEBAR AFTER CLICKING LINK
             */

            const sidebarLinks =
                document.querySelectorAll(".student-nav-link");


            sidebarLinks.forEach(function (link) {

                link.addEventListener("click", function () {

                    if (window.innerWidth <= 900) {

                        if (sidebar) {

                            sidebar.classList.remove("mobile-open");

                        }

                        if (overlay) {

                            overlay.classList.remove("show");

                        }

                    }

                });

            });

        });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>