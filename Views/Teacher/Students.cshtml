@model List<StudyGPT.Web.Models.StudentViewModel>

@{
    ViewData["Title"] = "Students";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="teacher-page">

    <div class="teacher-page-header">

        <div>

            <span class="teacher-section-label">
                STUDENT MANAGEMENT
            </span>

            <h1>
                Students
            </h1>

            <p>
                View students registered in the StudyGPT platform.
            </p>

        </div>

        <div class="teacher-page-header-icon">

            <i class="bi bi-people-fill"></i>

        </div>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="teacher-alert teacher-alert-success">

            <i class="bi bi-check-circle-fill"></i>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }


    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="teacher-alert teacher-alert-danger">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <span>
                @ViewBag.Error
            </span>

        </div>
    }


    <div class="teacher-summary-row">

        <div class="teacher-summary-card">

            <div class="teacher-summary-icon">

                <i class="bi bi-people-fill"></i>

            </div>

            <div>

                <span>
                    Total Students
                </span>

                <strong>
                    @(Model?.Count ?? 0)
                </strong>

            </div>

        </div>

    </div>


    <div class="teacher-card">

        <div class="teacher-card-header">

            <div>

                <h3>
                    Student List
                </h3>

                <p>
                    All students currently registered in the system.
                </p>

            </div>

            <div class="teacher-card-header-icon">

                <i class="bi bi-person-lines-fill"></i>

            </div>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="teacher-table-wrapper">

                <table class="teacher-table">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>Student</th>

                            <th>Email</th>

                            <th>Role</th>

                            <th>Status</th>

                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int index = 1;
                        }

                        @foreach (var student in Model)
                        {
                            <tr>

                                <td>

                                    <span class="student-number">
                                        @index
                                    </span>

                                </td>


                                <td>

                                    <div class="student-info">

                                        <div class="student-avatar">

                                            @{
                                                var name =
                                                string.IsNullOrWhiteSpace(student.FullName)
                                                ? "S"
                                                : student.FullName.Trim()
                                                    .Substring(0, 1)
                                                    .ToUpper();
                                            }

                                            @name

                                        </div>

                                        <div>

                                            <strong>
                                                @(string.IsNullOrWhiteSpace(student.FullName)
                                                    ? "Unknown Student"
                                                    : student.FullName)
                                            </strong>

                                            <small>
                                                Student ID: @student.Id
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    <span class="student-email">

                                        <i class="bi bi-envelope"></i>

                                        @student.Email

                                    </span>

                                </td>


                                <td>

                                    <span class="teacher-role-badge">

                                        <i class="bi bi-mortarboard-fill"></i>

                                        @(string.IsNullOrWhiteSpace(student.Role)
                                            ? "Student"
                                            : student.Role)

                                    </span>

                                </td>


                                <td>

                                    <span class="teacher-status-badge active">

                                        <span class="status-dot"></span>

                                        Active

                                    </span>

                                </td>


                                <td>

                                    <button type="button"
                                            class="teacher-action-btn"
                                            onclick="viewStudent(@student.Id)">

                                        <i class="bi bi-eye"></i>

                                        View

                                    </button>

                                </td>

                            </tr>

                            index++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="teacher-empty-state">

                <div class="teacher-empty-icon">

                    <i class="bi bi-people"></i>

                </div>

                <h3>
                    No Students Found
                </h3>

                <p>
                    There are currently no students registered in the system.
                </p>

            </div>
        }

    </div>

</div>


@section Scripts {

    <script>

        function viewStudent(studentId) {

            alert(
                "Student details page will be added next.\n\nStudent ID: "
                + studentId
            );

        }

    </script>

}