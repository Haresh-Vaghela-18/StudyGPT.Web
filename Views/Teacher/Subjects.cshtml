@model List<StudyGPT.Web.Models.SubjectViewModel>

@{
    ViewData["Title"] = "Subjects";
    Layout = "_TeacherLayout";
}

<div class="teacher-page">

    <!-- HEADER -->
    <div class="teacher-page-header">

        <div>

            <span class="teacher-section-label">
                SUBJECT MANAGEMENT
            </span>

            <h1>
                Manage Subjects
            </h1>

            <p>
                Create and manage subjects for your study materials.
            </p>

        </div>

        <div class="teacher-page-header-icon">

            <i class="bi bi-book-fill"></i>

        </div>

    </div>


    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="teacher-alert teacher-alert-success">

            <i class="bi bi-check-circle-fill"></i>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }


    <!-- ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="teacher-alert teacher-alert-danger">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <span>
                @TempData["Error"]
            </span>

        </div>
    }


    <!-- ADD SUBJECT -->
    <div class="teacher-card teacher-add-subject-card">

        <div class="teacher-card-header">

            <div>

                <h3>
                    Add New Subject
                </h3>

                <p>
                    Create a subject that can be used when uploading materials.
                </p>

            </div>

            <div class="teacher-card-header-icon">

                <i class="bi bi-plus-lg"></i>

            </div>

        </div>


        <form asp-controller="Teacher"
              asp-action="AddSubject"
              method="post">

            <div class="teacher-form-grid">

                <!-- SUBJECT NAME -->
                <div class="teacher-form-group">

                    <label>
                        Subject Name
                    </label>

                    <input type="text"
                           name="subjectName"
                           class="teacher-input"
                           placeholder="e.g. Mathematics"
                           required />

                </div>


                <!-- DESCRIPTION -->
                <div class="teacher-form-group">

                    <label>
                        Description
                    </label>

                    <input type="text"
                           name="description"
                           class="teacher-input"
                           placeholder="Short description of the subject" />

                </div>


                <!-- BUTTON -->
                <div class="teacher-form-button">

                    <button type="submit"
                            class="teacher-primary-btn">

                        <i class="bi bi-plus-circle"></i>

                        Add Subject

                    </button>

                </div>

            </div>

        </form>

    </div>


    <!-- SUBJECT LIST -->
    <div class="teacher-card">

        <div class="teacher-card-header">

            <div>

                <h3>
                    All Subjects
                </h3>

                <p>
                    Subjects available in your StudyGPT system.
                </p>

            </div>

            <div class="teacher-card-header-icon">

                <i class="bi bi-collection"></i>

            </div>

        </div>


        @if (Model == null || Model.Count == 0)
        {
            <div class="teacher-empty-state">

                <div class="teacher-empty-icon">

                    <i class="bi bi-book"></i>

                </div>

                <h3>
                    No Subjects Found
                </h3>

                <p>
                    Add your first subject using the form above.
                </p>

            </div>
        }
        else
        {
            <div class="teacher-table-wrapper">

                <table class="teacher-table">

                    <thead>

                        <tr>

                            <th>
                                ID
                            </th>

                            <th>
                                Subject
                            </th>

                            <th>
                                Description
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var subject in Model)
                        {
                            <tr>

                                <!-- ID -->
                                <td>

                                    <span class="student-number">
                                        @subject.SubjectId
                                    </span>

                                </td>


                                <!-- NAME -->
                                <td>

                                    <div class="material-info">

                                        <div class="material-icon">

                                            <i class="bi bi-book-fill"></i>

                                        </div>

                                        <div>

                                            <strong>
                                                @subject.SubjectName
                                            </strong>

                                        </div>

                                    </div>

                                </td>


                                <!-- DESCRIPTION -->
                                <td>

                                    @(string.IsNullOrWhiteSpace(subject.Description)
                                        ? "No description"
                                        : subject.Description)

                                </td>


                                <!-- ACTION -->
                                <td>

                                    <form asp-controller="Teacher"
                                          asp-action="DeleteSubject"
                                          method="post"
                                          style="display:inline;">

                                        <input type="hidden"
                                               name="id"
                                               value="@subject.SubjectId" />

                                        <button type="submit"
                                                class="teacher-action-btn teacher-delete-btn"
                                                onclick="return confirm('Delete this subject?');">

                                            <i class="bi bi-trash"></i>

                                            Delete

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>