@model StudyGPT.Web.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="profile-page">

    <div class="profile-header">

        <div class="profile-header-left">

            <div class="profile-large-avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <div class="profile-header-info">

                <span class="profile-label">
                    MY PROFILE
                </span>

                <h1>
                    @Model.FullName
                </h1>

                <p>
                    <i class="bi bi-person-workspace"></i>
                    Teacher Account
                </p>

            </div>

        </div>

    </div>


    @if (ViewBag.Error != null)
    {
        <div class="profile-alert">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <span>
                @ViewBag.Error
            </span>

        </div>
    }


    <div class="profile-grid">

        <div class="profile-card">

            <div class="profile-card-header">

                <div class="profile-card-icon">

                    <i class="bi bi-person-vcard-fill"></i>

                </div>

                <div>

                    <span>
                        ACCOUNT INFORMATION
                    </span>

                    <h2>
                        Personal Details
                    </h2>

                </div>

            </div>


            <div class="profile-details">

                <div class="profile-detail">

                    <div class="detail-icon">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div class="detail-content">

                        <span>
                            Full Name
                        </span>

                        <strong>
                            @Model.FullName
                        </strong>

                    </div>

                </div>


                <div class="profile-detail">

                    <div class="detail-icon">
                        <i class="bi bi-envelope-fill"></i>
                    </div>

                    <div class="detail-content">

                        <span>
                            Email Address
                        </span>

                        <strong>
                            @Model.Email
                        </strong>

                    </div>

                </div>

@* 
                <div class="profile-detail">

                    <div class="detail-icon">
                        <i class="bi bi-hash"></i>
                    </div>

                    <div class="detail-content">

                        <span>
                            User ID
                        </span>

                        <strong>
                            @Model.Id
                        </strong>

                    </div>

                </div>
 *@

                <div class="profile-detail">

                    <div class="detail-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div class="detail-content">

                        <span>
                            Account Role
                        </span>

                        <strong>
                            @Model.Role
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <div class="profile-card teacher-account-card">

            <div class="teacher-card-top">

                <div class="teacher-icon">

                    <i class="bi bi-person-workspace"></i>

                </div>

                <span class="teacher-badge">
                    TEACHER
                </span>

            </div>


            <h2>
                Teacher Account
            </h2>


            <p>
                Your StudyGPT teacher account allows you to manage
                subjects, upload study materials and provide
                learning resources to students.
            </p>


            <div class="teacher-features">

                <div>
                    <i class="bi bi-book-fill"></i>
                    <span>Manage Subjects</span>
                </div>

                <div>
                    <i class="bi bi-file-earmark-text-fill"></i>
                    <span>Upload Study Materials</span>
                </div>

                <div>
                    <i class="bi bi-people-fill"></i>
                    <span>Manage Student Learning</span>
                </div>

                <div>
                    <i class="bi bi-robot"></i>
                    <span>StudyGPT AI Learning Platform</span>
                </div>

            </div>


            <a asp-controller="Teacher"
               asp-action="Dashboard"
               class="teacher-dashboard-btn">

                <i class="bi bi-grid-1x2-fill"></i>

                Back to Dashboard

            </a>

        </div>

    </div>

</div>